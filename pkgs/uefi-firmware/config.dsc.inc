
#
# SOC Support
#
CONFIG_SOC_XAVIER=y
CONFIG_SOC_ORIN=y
CONFIG_SOC_JETSON=y
# CONFIG_SOC_GRACE is not set
# end of SOC Support

#
# Security options
#
CONFIG_SECURITY_TPM_SUPPORT=y
# CONFIG_SECURITY_TPM_DISCRETE is not set
CONFIG_SECURITY_TPM_FIRMWARE=y
# CONFIG_SECURITY_TPM_NONE is not set
CONFIG_SECURITY_UEFI_MENU_USER_AUTH=y
CONFIG_SECURITY_MM_SUPPORT=y
# CONFIG_SECURITY_MM_NONE is not set
# CONFIG_SECURITY_MM_FFA is not set
CONFIG_SECURITY_MM_OPTEE=y
CONFIG_SECURITY_PHYSICAL_PRESENCE=y
CONFIG_SECURITY_DISABLE_PHYSICAL_PRESENCE_POST_SECUREBOOT=y
CONFIG_SECURITY_UEFI_SECURE_BOOT=y
# end of Security options

#
# Variable options
#
# CONFIG_VARIABLE_EMULATED is not set
CONFIG_VARIABLE_NON_SECURE_SUPPORTED=y
# end of Variable options

#
# Hardware support
#
CONFIG_PCIE=y
CONFIG_DESIGNWARE_PCIE=y
CONFIG_NVME=y
CONFIG_SDHCI=y
CONFIG_NVIDIA_SDHCI=y
CONFIG_EMMC=y
CONFIG_SDCARD=y
CONFIG_UFS=y
CONFIG_SATA=y
CONFIG_SCSI=y
CONFIG_NETWORKING_DEVICE_NVIDIA=y
CONFIG_SOC_USB=y
CONFIG_USB=y
CONFIG_XHCI=y
CONFIG_EHCI=y
# CONFIG_UHCI is not set

#
# USB Devices
#
CONFIG_USB_MASS_STORAGE=y
CONFIG_USB_KEYBOARD=y
CONFIG_USB_MOUSE=y
# end of USB Devices

# CONFIG_USB_FW_RENESAS is not set

#
# Display hardware
#
CONFIG_NVIDIA_DISPLAY=y
# CONFIG_ASPEED_2600_DISPLAY is not set
# end of Display hardware

CONFIG_IPMI_BMC=y
# CONFIG_REDFISH is not set
CONFIG_FIRMWARE_PARTITION_SUPPORT=y
# CONFIG_SERIAL_PORT_CONSOLE_MDEMODULE is not set
CONFIG_SERIAL_PORT_CONSOLE_TEGRA=y
# CONFIG_SERIAL_PORT_CONSOLE_NONE is not set
CONFIG_REAL_TIME_CLOCK_MAXIM=y
# CONFIG_REAL_TIME_CLOCK_NUVOTON is not set
# CONFIG_BOOTLOADER_RAMDISK is not set
# end of Hardware support

#
# OS Hardware description
#
CONFIG_CONFIG_MANAGER=y
CONFIG_ACPI=y
CONFIG_DEVICETREE=y
CONFIG_SMBIOS=y
CONFIG_SMBIOS_ARM=y
CONFIG_ACPI_THERMAL_ZONE_SINGLE=y
# end of OS Hardware description

#
# Boot Options
#
# CONFIG_RCM_BOOT is not set
CONFIG_BOOT_QUICK_BOOT=y
CONFIG_BOOT_QUICK_BOOT_ENABLED=y
CONFIG_BOOT_DEFAULT_TIMEOUT=5
CONFIG_BOOT_NATIVE_ANDROID_PARTITION_SUPPORT=y
CONFIG_BOOT_ANDROID_FASTBOOT=y
CONFIG_BOOT_NVIDIA_CUSTOM_OPTION_DESCRIPTION=y
CONFIG_SINGLE_BOOT_NONE=y
# CONFIG_SINGLE_BOOT_DEADLOOP_APP is not set
# CONFIG_SINGLE_BOOT_L4T_LAUNCHER is not set
CONFIG_SOC_DISPLAY_HANDOFF_MODE_NEVER=y
# CONFIG_SOC_DISPLAY_HANDOFF_MODE_ALWAYS is not set
# CONFIG_SOC_DISPLAY_HANDOFF_MODE_AUTO is not set
CONFIG_L4T=y
CONFIG_DEFAULT_GOP_MODE_MAX=y
# CONFIG_DEFAULT_GOP_MODE_1080p is not set
# CONFIG_DEFAULT_GOP_MODE_800_600 is not set
CONFIG_LOGO=y
# end of Boot Options

#
# Debug Options
#
# CONFIG_DEBUG_PRINT_ENABLE_RELEASE is not set
# CONFIG_HALT_ON_ASSERT is not set
CONFIG_DEBUG_PROPERTY_DEBUG=0x4f
CONFIG_DEBUG_PROPERTY_RELEASE=0x41
# CONFIG_DEBUG_LOG_SCRATCH_REG is not set
# CONFIG_MEMORY_TEST is not set
# end of Debug Options

CONFIG_FIRMWARE_MANAGEMENT=y
CONFIG_FIRMWARE_MANAGEMENT_DIRECT=y
# CONFIG_FIRMWARE_MANAGEMENT_EROT is not set
# CONFIG_FIRMWARE_MANAGEMENT_BLOB is not set
CONFIG_FIRMWARE_MANAGEMENT_FMP_ESRT_GUID=7C374309-1649-4682-8BEE-04F3A8399414
CONFIG_FIRMWARE_CAPSULE_SUPPORTED=y
CONFIG_FIRMWARE_CAPSULE_SIZE=0xc00000

#
# Watchdog settings
#
CONFIG_BOOT_WATCHDOG_TIMEOUT=5
# CONFIG_ARM_WATCHDOG is not set
# end of Watchdog settings

CONFIG_NETWORKING=y
CONFIG_NETWORKING_HTTP=y
CONFIG_NETWORKING_PXE=y
CONFIG_NETWORKING_ISCSI=y
CONFIG_NETWORKING_VLAN=y
CONFIG_NETWORKING_IPV4=y
CONFIG_NETWORKING_IPV6=y

#
# Network devices
#
# CONFIG_NETWORKING_DEVICE_INTEL is not set
CONFIG_NETWORKING_DEVICE_REALTEK=y
CONFIG_NETWORKING_DEVICE_ASIX=y
# CONFIG_NETWORKING_DEVICE_USB_RNDIS is not set
# end of Network devices

#
# Filesystems
#
CONFIG_FS_FAT=y
CONFIG_FS_EXT4=y
CONFIG_FS_FIRMWARE_VOLUME=y
# end of Filesystems

CONFIG_SHELL=y
# CONFIG_SHELL_LEVEL_MINIMAL is not set
# CONFIG_SHELL_LEVEL_SCRIPTING is not set
# CONFIG_SHELL_LEVEL_BASIC is not set
CONFIG_SHELL_LEVEL_INTERACTIVE=y
CONFIG_SHELL_LEVEL_1_SUPPORTED=y
CONFIG_SHELL_LEVEL_2_SUPPORTED=y
CONFIG_SHELL_LEVEL_3_SUPPORTED=y
CONFIG_SHELL_DEBUG_COMMANDS=y
CONFIG_SHELL_DRIVER_COMMANDS=y
CONFIG_SHELL_NETWORK_COMMANDS=y
CONFIG_NVIDIA_SHELL_APPLICATIONS=y
# CONFIG_EBC is not set
